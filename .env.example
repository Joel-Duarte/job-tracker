# ==============================================================================
# Job Tracker - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Port Bindings (Collision-Resistant Defaults)
# ------------------------------------------------------------------------------
FRONTEND_PORT=4173
BACKEND_PORT=8008
POSTGRES_PORT=54320
CAMOUFOX_PORT=9333

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ------------------------------------------------------------------------------
# 3. Public API Base URL
# Optional: Set this if running behind a reverse proxy or public domain
# (e.g. https://tracker.example.com or http://localhost:8008)
# ------------------------------------------------------------------------------
PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 4. LLM & Embedding Service Configuration
# Defaults to local LM Studio / Ollama instance on the host machine
# ------------------------------------------------------------------------------
LLM_PROVIDER_NAME=openai
LLM_API_BASE=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-1234
LLM_MODEL_NAME=qwen/qwen3.5-9b

EMBEDDING_API_URL=http://host.docker.internal:1234/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=nomic-embed-text-v2-moe
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 5. OAuth Provider Credentials (Optional)
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_ID=
