# ==============================================================================
# Job Tracker - Deployment and Bootstrap Environment
# ==============================================================================

# Docker project and host port bindings
COMPOSE_PROJECT_NAME=job-tracker
BIND_HOST=127.0.0.1
# Set BIND_HOST=0.0.0.0 only when LAN access and API authorization are configured.
FRONTEND_PORT=4173
FRONTEND_DEV_PORT=5173
BACKEND_PORT=8008
POSTGRES_PORT=54320
# The bundled Camofox API is internal to Docker; use an external-services override for a separate instance.

# PostgreSQL bootstrap connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=postgres

# Application bootstrap and public URLs
ENVIRONMENT=development
LOG_LEVEL=DEBUG
# SECRET_KEY is optional for development/staging; if left empty, a secure Fernet key will be auto-generated and saved to data/.sec_key
SECRET_KEY=
ADMIN_SECRET=
PUBLIC_API_URL=
PUBLIC_FRONTEND_URL=http://localhost:5173
CAMOUFOX_ENDPOINT=http://localhost:9377
